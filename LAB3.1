#include <iostream>
#include <cmath>

using namespace std;

int main()
{
   system ("chcp 1251"); // Задали Українську мову в код для розуміння висновку
    
    double x; // Вхідне число
    double y; // Фінальне обчислення
    double A; // Незмінна частина
    double B; // Змінна частина

    cout << "x = "; cin >> x;
    
    A = 1.0 / pow(x, 3) + 1.0; // Значення перед дужками
    if (x < 1)                 // Перевіряємо перший if 
    {                               
        B = 0.3 * x + 7;       // Вираз до першого if 
    }
    else if (x >= 1 && x <= 5.5) // Запис другого if в разі розгалуження
    {
        B = atan((x + 2) / 8.1) + exp(x); // Вираз другого if
    }
    else
    {
        B = sqrt(1 + sqrt(1 + sqrt(x))); // Останній вираз
    }
    y = A - B; // фінальне рішення 

    cout << "Результат y = " << y << endl;

    return 0;

}

